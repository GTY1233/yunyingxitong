# 文案生成 API（OpenAI 兼容接口）
COPY_API_KEY=
COPY_API_URL=https://api.deepseek.com/chat/completions
COPY_API_MODEL=deepseek-chat

# 图片 / 视频生成（RunningHub）
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_IMAGE_APP_ID=2019050132657934337
RUNNINGHUB_VIDEO_APP_ID=1975951975441412098
# 视频工作流需要参考视频：可填公网 mp4 URL、RunningHub 上传后的文件名，或后续在页面单次填写
# RUNNINGHUB_VIDEO_REFERENCE_VIDEO=
# 上传接口返回 download_url / fileName 两种值，默认按文档示例使用 download_url
# RUNNINGHUB_UPLOAD_VALUE_FIELD=download_url
# RUNNINGHUB_POLL_INTERVAL=2000
# RUNNINGHUB_POLL_MAX=90
