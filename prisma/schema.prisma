// 阶段一数据层 schema（Prisma + SQLite）。详见 docs/12-stage1-data-layer-design.md。
// 设计纪律：状态单一真相源（商品不存派生状态）、真实时间戳、无反范式冗余、内嵌数组拆表。
// 注意：SQLite 无原生 JSON 类型，platforms/colors/params/meta/missing/platformResponse 等以 JSON 字符串存于 String 列。

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  tenantId      String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id            String  @id @default(cuid())
  displayCode   String? @map("display_code") // 旧业务编号 P1027，便于对照
  skuCode       String? @map("sku_code")
  name          String
  category      String?
  priceCents    Int?    @map("price_cents") // 统一存“分”，杜绝浮点
  stock         Int     @default(0)
  warningStock  Int     @default(0) @map("warning_stock")
  sellingPoints String? @map("selling_points")
  specs         String?
  platforms     String? // JSON 字符串
  colors        String? // JSON 字符串
  status        String?

  assets          Asset[]
  workflows       PlatformWorkflow[]
  generationTasks GenerationTask[]
  listingTasks    ListingTask[]
  publishTasks    PublishTask[]
  productMappings PlatformProductMapping[]
  logs            OperationLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("products")
}

model Account {
  tenantId String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id       String  @id @default(cuid())
  platform String?
  name     String?
  type     String? // 店铺账号 / 内容账号
  role     String? // main_shop | authorized | creator
  auth     String?
  rule     String?
  persona  String?
  publishHandle String? @map("publish_handle") // social-auto-upload 的 --account 账号名(留空则用 name)
  isDemo   Boolean @default(false) @map("is_demo")

  listingTasks ListingTask[]
  publishTasks PublishTask[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("accounts")
}

model Asset {
  tenantId         String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id               String  @id @default(cuid())
  productId        String  @map("product_id")
  generationTaskId String? @map("generation_task_id") // 仅作引用，不建强关系，避免循环
  kind             String // image | copy | video
  type             String?
  name             String?
  status           String?
  usage            String?
  version          String?
  provider         String?
  isPrimary        Boolean @default(false) @map("is_primary")
  isAiGenerated    Boolean @default(false) @map("is_ai_generated") // AIGC 标识(2025-09 法规:AI 生成内容须显式标识)
  aiNote           String? @map("ai_note") // 标识说明(如「内容由AI辅助生成」)
  content          String?
  mediaUrl         String? @map("media_url") // 导入时重指向 media-backup 本地文件
  posterUrl        String? @map("poster_url")
  aspectRatio      String? @map("aspect_ratio")
  duration         String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([productId])
  @@map("assets")
}

model PlatformWorkflow {
  tenantId      String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id            String  @id @default(cuid())
  productId     String  @map("product_id")
  platform      String
  template      String?
  status        String?
  currentNodeId String? @map("current_node_id")
  autoMode      Boolean @default(false) @map("auto_mode") // 自动流水线:节点成功后自动推进,停在待确认/失败

  product Product        @relation(fields: [productId], references: [id])
  nodes   WorkflowNode[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([productId])
  @@map("platform_workflows")
}

model WorkflowNode {
  id         String  @id @default(cuid())
  workflowId String  @map("workflow_id")
  nodeKey    String  @map("node_key")
  seq        Int
  label      String?
  type       String?
  kind       String?
  status     String  @default("未开始") // 流程状态的唯一真相源（受控 7 态）
  error      String?
  meta       String? // JSON：旧 taskId/taskIds/hint/params 归并

  workflow PlatformWorkflow @relation(fields: [workflowId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([workflowId])
  @@map("workflow_nodes")
}

model GenerationTask {
  tenantId           String    @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id                 String    @id @default(cuid())
  productId          String    @map("product_id")
  platformWorkflowId String?   @map("platform_workflow_id")
  assetId            String?   @map("asset_id")
  kind               String?
  type               String?
  label              String?
  params             String? // JSON
  status             String?
  provider           String?
  error              String?
  attempts           Int       @default(0)
  maxAttempts        Int       @default(2) @map("max_attempts")
  startedAt          DateTime? @map("started_at")
  finishedAt         DateTime? @map("finished_at")

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([productId])
  @@map("generation_tasks")
}

model ListingTask {
  tenantId           String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id                 String  @id @default(cuid())
  productId          String  @map("product_id")
  accountId          String? @map("account_id")
  platform           String?
  status             String?
  completeness       Int     @default(0)
  missing            String? // JSON
  mode               String?
  platformMode       String? @map("platform_mode")
  platformCapability String? @map("platform_capability")
  externalId         String? @map("external_id")
  platformResponse   String? @map("platform_response") // JSON
  failureReason      String? @map("failure_reason")
  attempts           Int     @default(0)
  maxAttempts        Int     @default(2) @map("max_attempts")

  product Product  @relation(fields: [productId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([productId])
  @@map("listing_tasks")
}

model PublishTask {
  tenantId      String    @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id            String    @id @default(cuid())
  productId     String    @map("product_id")
  accountId     String?   @map("account_id")
  assetId       String?   @map("asset_id")
  platform      String?
  status        String?
  scheduleSlot  String?   @map("schedule_slot")
  scheduledAt   DateTime? @map("scheduled_at") // 真实时间，替代 "今天18:00"
  publishedAt   DateTime? @map("published_at")
  attachProduct Boolean   @default(true) @map("attach_product")
  mode          String?
  failureReason String?   @map("failure_reason")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(2) @map("max_attempts")

  product Product  @relation(fields: [productId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([productId])
  @@map("publish_tasks")
}

model PlatformProductMapping {
  tenantId          String @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id                String @id @default(cuid())
  productId         String @map("product_id")
  platform          String
  externalProductId String @map("external_product_id")

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, platform])
  @@map("platform_product_mappings")
}

model OperationLog {
  tenantId  String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id        String  @id @default(cuid())
  productId String? @map("product_id")
  kind      String?
  message   String?
  level     String?

  product Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("operation_logs")
}

// 模特图库（全局,不绑定商品;换装生图时选一张作 node41 模特图）
model ModelImage {
  tenantId  String    @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id        String    @id @default(cuid())
  name      String?
  mediaUrl  String    @map("media_url") // uploads/model-xxx.png
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("model_images")
}

// 参考视频库（全局;生视频时选一段作 node161 参考视频,决定动作/节奏）
model ReferenceVideo {
  tenantId  String    @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id        String    @id @default(cuid())
  name      String?
  mediaUrl  String    @map("media_url") // uploads/refvideo-xxx.mp4
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("reference_videos")
}

// 平台凭证（app_key/secret/token;secret 与 token 字段为 AES-GCM 密文）
// api:douyin_shop(上架)| douyin_open(发布)。runMode:demo|real|manual。
model PlatformCredential {
  tenantId String  @default("default") @map("tenant_id") // 多租户预留:自用期恒为 default,售卖时按租户过滤
  id       String  @id @default(cuid())
  platform String // 抖音
  api      String // douyin_shop | douyin_open
  label    String?
  role     String? // main_shop | creator

  appKey       String? @map("app_key")
  appSecretEnc String? @map("app_secret_enc") // 密文

  shopId           String?   @map("shop_id")
  accessTokenEnc   String?   @map("access_token_enc") // 密文
  refreshTokenEnc  String?   @map("refresh_token_enc") // 密文
  tokenExpiresAt   DateTime? @map("token_expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")

  runMode   String  @default("demo") // demo | real | manual
  status    String  @default("未授权") // 未授权|已授权|授权过期|刷新失败
  lastError String? @map("last_error")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([platform, api])
  @@map("platform_credentials")
}
