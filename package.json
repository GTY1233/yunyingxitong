{
  "name": "yunyingxitong",
  "version": "0.1.0",
  "private": true,
  "description": "AI ecommerce operations automation system MVP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:api": "tsx src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck:web": "vue-tsc -p web/tsconfig.json --noEmit",
    "preview:web": "vite preview",
    "check": "node scripts/check-js.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.5.17",
    "element-plus": "^2.14.2",
    "fastify": "^5.8.5",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.12"
  }
}
